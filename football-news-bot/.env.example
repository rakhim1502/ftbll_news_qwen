# === Telegram bot (majburiy) ===
# @BotFather orqali olinadigan token
BOT_TOKEN=

# === AI API kalitlari (ixtiyoriy — qisqartirish/tarjima uchun) ===
# Kalitlar bo'lmasa bot avtomatik AI'siz (naqshli) rejimda ishlaydi.
# GEMINI_API_KEY: https://aistudio.google.com/apikey sahifasidan olinadi.
GEMINI_API_KEY=
# QWEN_API_KEY: https://dashscope.console.aliyun.com (Model Studio) orqali.
QWEN_API_KEY=

# Model nomlari (ixtiyoriy — Google/Alibaba deprecate qilsa shu yerda almashtiring)
GEMINI_MODEL=gemini-2.0-flash
QWEN_MODEL=qwen-plus

# === Sozlamalar (ixtiyoriy) ===
# "Bugungi" deb hisoblanadigan maksimal xabar yoshi (soatda)
NEWS_MAX_AGE_HOURS=36
